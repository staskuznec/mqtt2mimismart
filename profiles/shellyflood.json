{
  "name": "Shelly Flood — датчик протечки",
  "model": "SHWT-1",
  "note": "Батарейный датчик, публикует при пробуждении и при срабатывании. Признак протечки уходит одним байтом — заводите его на однобайтовый элемент, а не на датчик. Уровень сигнала WiFi берётся из топика info: полный статус устройство публикует при пробуждении, поэтому уровень обновляется вместе с остальными значениями, а не постоянно.",
  "roles": [
    {
      "key": "flood",
      "title": "Протечка",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script"
      ],
      "required": true,
      "hint": "однобайтовый элемент: 1 — вода обнаружена"
    },
    {
      "key": "temp",
      "title": "Температура, °C",
      "form": "sensor",
      "types": [
        "temperature-sensor",
        "float-sensor",
        "virtual"
      ]
    },
    {
      "key": "battery",
      "title": "Заряд батареи, %",
      "form": "sensor",
      "types": [
        "humidity-sensor",
        "percent-sensor",
        "virtual",
        "virtual"
      ]
    },
    {
      "key": "signal",
      "title": "Уровень сигнала WiFi",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: плохой, нормальный или хороший"
    }
  ],
  "links": [
    {
      "name": "Протечка",
      "direction": "in",
      "role": "flood",
      "topic": "{{prefix}}/flood",
      "encode": "byte",
      "values": {
        "true": "1",
        "false": "0"
      },
      "only_changed": false
    },
    {
      "name": "Температура",
      "direction": "in",
      "role": "temp",
      "topic": "{{prefix}}/temperature",
      "encode": "sensor",
      "only_changed": false
    },
    {
      "name": "Заряд батареи",
      "direction": "in",
      "role": "battery",
      "topic": "{{prefix}}/battery",
      "encode": "sensor",
      "only_changed": false
    },
    {
      "name": "Уровень сигнала WiFi",
      "direction": "in",
      "role": "signal",
      "topic": "{{prefix}}/info",
      "extract": "json",
      "extract_path": "wifi_sta.rssi",
      "encode": "text",
      "values": {
        "<=-80": "плохой",
        "<=-70": "нормальный",
        "*": "хороший"
      },
      "only_changed": false
    }
  ]
}
