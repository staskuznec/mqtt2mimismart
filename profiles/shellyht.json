{
  "name": "Shelly H&T — температура и влажность",
  "model": "SHHT-1",
  "note": "Батарейный датчик: публикует только когда просыпается, поэтому отсев повторов здесь скорее мешает — значения и так приходят редко. По HTTP такое устройство недоступно вовсе, и в старой схеме опроса его было не завести. Уровень сигнала WiFi берётся из топика info: полный статус устройство публикует при пробуждении, поэтому уровень обновляется вместе с остальными значениями, а не постоянно.",
  "roles": [
    {
      "key": "temp",
      "title": "Температура, °C",
      "form": "sensor",
      "types": [
        "temperature-sensor",
        "float-sensor",
        "virtual"
      ],
      "required": true
    },
    {
      "key": "humidity",
      "title": "Влажность, %",
      "form": "sensor",
      "types": [
        "humidity-sensor",
        "percent-sensor",
        "virtual"
      ]
    },
    {
      "key": "battery",
      "title": "Заряд батареи, %",
      "form": "sensor",
      "types": [
        "humidity-sensor",
        "percent-sensor",
        "virtual",
        "virtual"
      ]
    },
    {
      "key": "signal",
      "title": "Уровень сигнала WiFi",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: плохой, нормальный или хороший"
    }
  ],
  "links": [
    {
      "name": "Температура",
      "direction": "in",
      "role": "temp",
      "topic": "{{prefix}}/temperature",
      "encode": "sensor",
      "only_changed": false
    },
    {
      "name": "Влажность",
      "direction": "in",
      "role": "humidity",
      "topic": "{{prefix}}/humidity",
      "encode": "sensor",
      "only_changed": false
    },
    {
      "name": "Заряд батареи",
      "direction": "in",
      "role": "battery",
      "topic": "{{prefix}}/battery",
      "encode": "sensor",
      "only_changed": false
    },
    {
      "name": "Уровень сигнала WiFi",
      "direction": "in",
      "role": "signal",
      "topic": "{{prefix}}/info",
      "extract": "json",
      "extract_path": "wifi_sta.rssi",
      "encode": "text",
      "values": {
        "<=-80": "плохой",
        "<=-70": "нормальный",
        "*": "хороший"
      },
      "only_changed": false
    }
  ]
}
