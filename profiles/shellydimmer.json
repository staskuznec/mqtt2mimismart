{
  "name": "Shelly Dimmer 1/2 — диммер",
  "model": "SHDM-2",
  "note": "Включение и выключение работают через команду в формате JSON. ЯРКОСТЬЮ ПОКА УПРАВЛЯТЬ НЕЛЬЗЯ: устройство ждёт {\"brightness\":75}, а таблица значений подставить число в шаблон нагрузки не умеет — это ближайшая доработка. Показания яркости при этом читаются и в умный дом приходят. Уровень сигнала WiFi берётся из топика info: туда устройство публикует полный статус с периодом, заданным в настройках MQTT. Если период равен нулю, топик не появится и элемент останется пустым.",
  "roles": [
    {
      "key": "light",
      "title": "Светильник — включение",
      "form": "byte",
      "types": [
        "dimer-lamp",
        "lamp"
      ],
      "required": true
    },
    {
      "key": "brightness",
      "title": "Яркость, 0–100 (только чтение)",
      "form": "byte",
      "types": [
        "dimer-lamp",
        "lamp",
        "virtual"
      ]
    },
    {
      "key": "power0",
      "title": "Мощность, Вт",
      "form": "text",
      "types": [
        "virtual"
      ]
    },
    {
      "key": "energy0",
      "title": "Энергия, кВт·ч",
      "form": "text",
      "types": [
        "virtual"
      ]
    },
    {
      "key": "input0",
      "title": "Вход 1",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script",
        "virtual"
      ]
    },
    {
      "key": "input1",
      "title": "Вход 2",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script",
        "virtual"
      ]
    },
    {
      "key": "temp",
      "title": "Температура устройства, °C",
      "form": "sensor",
      "types": [
        "temperature-sensor",
        "float-sensor",
        "virtual"
      ]
    },
    {
      "key": "overtemp",
      "title": "Признак перегрева",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script",
        "virtual"
      ]
    },
    {
      "key": "online",
      "title": "Устройство на связи",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: «онлайн» или «офлайн» словом, а не лампой"
    },
    {
      "key": "signal",
      "title": "Уровень сигнала WiFi",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: плохой, нормальный или хороший"
    }
  ],
  "links": [
    {
      "name": "Состояние светильника",
      "direction": "in",
      "role": "light",
      "pair": "light",
      "topic": "{{prefix}}/light/0",
      "encode": "byte",
      "values": {
        "on": "1",
        "off": "0"
      }
    },
    {
      "name": "Команда светильнику",
      "direction": "out",
      "role": "light",
      "pair": "light",
      "topic": "{{prefix}}/light/0/set",
      "kind": "command",
      "decode": "lamp",
      "qos": 1,
      "values": {
        "on": "{\"turn\":\"on\"}",
        "off": "{\"turn\":\"off\"}",
        "toggle": "{\"turn\":\"toggle\"}"
      }
    },
    {
      "name": "Яркость",
      "direction": "in",
      "role": "brightness",
      "topic": "{{prefix}}/light/0/brightness",
      "encode": "byte"
    },
    {
      "name": "Мощность",
      "direction": "in",
      "role": "power0",
      "topic": "{{prefix}}/light/0/power",
      "encode": "text",
      "unit": " Вт",
      "precision": 0
    },
    {
      "name": "Энергия",
      "direction": "in",
      "role": "energy0",
      "topic": "{{prefix}}/light/0/energy",
      "encode": "text",
      "unit": " кВт",
      "precision": 1,
      "scale": 1.6666666666666667e-05
    },
    {
      "name": "Вход 1",
      "direction": "in",
      "role": "input0",
      "topic": "{{prefix}}/input/0",
      "encode": "byte"
    },
    {
      "name": "Вход 2",
      "direction": "in",
      "role": "input1",
      "topic": "{{prefix}}/input/1",
      "encode": "byte"
    },
    {
      "name": "Температура устройства",
      "direction": "in",
      "role": "temp",
      "topic": "{{prefix}}/temperature",
      "encode": "sensor"
    },
    {
      "name": "Перегрев",
      "direction": "in",
      "role": "overtemp",
      "topic": "{{prefix}}/overtemperature",
      "encode": "byte"
    },
    {
      "name": "На связи",
      "direction": "in",
      "role": "online",
      "topic": "{{prefix}}/online",
      "encode": "text",
      "values": {
        "true": "онлайн",
        "false": "офлайн"
      }
    },
    {
      "name": "Уровень сигнала WiFi",
      "direction": "in",
      "role": "signal",
      "topic": "{{prefix}}/info",
      "extract": "json",
      "extract_path": "wifi_sta.rssi",
      "encode": "text",
      "values": {
        "<=-80": "плохой",
        "<=-70": "нормальный",
        "*": "хороший"
      }
    }
  ]
}
