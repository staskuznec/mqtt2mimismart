{
  "name": "Shelly 2.5 — режим роллера",
  "model": "SHSW-25",
  "note": "Шторы, ворота, маркиза. В режиме роллера устройство не публикует relay/* вовсе — только roller/0. Положение 0–100 ложится в один байт, как раз под элемент штор умного дома. Напряжение и состояние температуры устройство шлёт, хотя в документации Gen1 их нет.",
  "roles": [
    {
      "key": "roller",
      "title": "Привод — положение и управление",
      "form": "byte",
      "required": true,
      "hint": "элемент штор: положение 0–100 помещается в один байт"
    },
    {
      "key": "power",
      "title": "Мощность, Вт",
      "form": "text"
    },
    {
      "key": "energy",
      "title": "Энергия, кВт·ч",
      "form": "text"
    },
    {
      "key": "voltage",
      "title": "Напряжение сети, В",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "устройство его публикует, хотя в документации Gen1 этого нет"
    },
    {
      "key": "temp_status",
      "title": "Состояние температуры",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "Normal, High или Very High — словами, как их шлёт устройство"
    },
    {
      "key": "temp",
      "title": "Температура устройства, °C",
      "form": "sensor"
    },
    {
      "key": "online",
      "title": "Устройство на связи",
      "form": "byte"
    }
  ],
  "links": [
    {
      "name": "Положение привода",
      "direction": "in",
      "role": "roller",
      "pair": "roller",
      "topic": "{{prefix}}/roller/0",
      "encode": "byte",
      "values": {
        "open": "100",
        "close": "0",
        "stop": "0"
      }
    },
    {
      "name": "Команда приводу",
      "direction": "out",
      "role": "roller",
      "pair": "roller",
      "topic": "{{prefix}}/roller/0/command",
      "kind": "command",
      "decode": "byte",
      "qos": 1,
      "values": {
        "0": "close",
        "100": "open"
      }
    },
    {
      "name": "Мощность",
      "direction": "in",
      "role": "power",
      "topic": "{{prefix}}/roller/0/power",
      "encode": "text",
      "unit": " Вт",
      "precision": 0
    },
    {
      "name": "Энергия",
      "direction": "in",
      "role": "energy",
      "topic": "{{prefix}}/roller/0/energy",
      "encode": "text",
      "unit": " кВт",
      "precision": 1,
