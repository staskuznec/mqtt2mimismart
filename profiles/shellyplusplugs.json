{
  "name": "Shelly Plus Plug S — розетка",
  "model": "SNPL-00112EU",
  "note": "Розетка с измерением. Кнопка на корпусе отдельным топиком не публикуется. В настройках устройства → MQTT включите «Generic status update over MQTT» (status_ntf), иначе оно не публикует состояние вовсе и связки останутся пустыми. Префикс топика по умолчанию — идентификатор устройства, например shellyplus1pm-a8032abd1eb4.",
  "roles": [
    {
      "key": "ch0",
      "title": "Канал",
      "form": "byte",
      "types": [
        "lamp",
        "script"
      ],
      "required": true
    },
    {
      "key": "power0",
      "title": "Мощность канала 0, Вт",
      "form": "text",
      "types": [
        "virtual"
      ]
    },
    {
      "key": "energy0",
      "title": "Энергия канала 0, кВт",
      "form": "text",
      "types": [
        "virtual"
      ]
    },
    {
      "key": "voltage",
      "title": "Напряжение сети, В",
      "form": "text",
      "types": [
        "virtual"
      ]
    },
    {
      "key": "current",
      "title": "Ток, А",
      "form": "text",
      "types": [
        "virtual"
      ]
    },
    {
      "key": "temp",
      "title": "Температура устройства, °C",
      "form": "sensor",
      "types": [
        "temperature-sensor",
        "float-sensor",
        "virtual"
      ]
    },
    {
      "key": "online",
      "title": "Устройство на связи",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script"
      ],
      "hint": "по завещанию брокеру: пропало питание — элемент погаснет"
    }
  ],
  "links": [
    {
      "name": "Канал — состояние",
      "direction": "in",
      "role": "ch0",
      "pair": "ch0",
      "topic": "{{prefix}}/status/switch:0",
      "extract": "json",
      "extract_path": "output",
      "encode": "byte",
      "values": {
        "true": "1",
        "false": "0"
      }
    },
    {
      "name": "Канал — команда",
      "direction": "out",
      "role": "ch0",
      "pair": "ch0",
      "topic": "{{prefix}}/rpc",
      "kind": "command",
      "decode": "lamp",
      "qos": 1,
      "values": {
        "on": "{\"id\":1,\"src\":\"mqtt2mimismart\",\"method\":\"Switch.Set\",\"params\":{\"id\":0,\"on\":true}}",
        "off": "{\"id\":1,\"src\":\"mqtt2mimismart\",\"method\":\"Switch.Set\",\"params\":{\"id\":0,\"on\":false}}",
        "toggle": "{\"id\":1,\"src\":\"mqtt2mimismart\",\"method\":\"Switch.Toggle\",\"params\":{\"id\":0}}"
      }
    },
    {
      "name": "Мощность канала 0",
      "direction": "in",
      "role": "power0",
      "topic": "{{prefix}}/status/switch:0",
      "extract": "json",
