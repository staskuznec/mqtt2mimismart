{
  "name": "Shelly 1PM — реле с измерением",
  "model": "SHSW-PM",
  "note": "Один канал плюс мощность, энергия и температура. Энергия в ватт-минутах, множитель до киловатт-часов уже задан. Уровень сигнала WiFi берётся из топика info: туда устройство публикует полный статус с периодом, заданным в настройках MQTT. Если период равен нулю, топик не появится и элемент останется пустым. Слово overpower в топике состояния означает, что канал выбило защитой по мощности и он выключен, поэтому в элемент оно переводится нулём: реле в этот момент не горит, и показывать «включено» — врать.",
  "roles": [
    {
      "key": "ch0",
      "title": "Канал — свет или нагрузка",
      "form": "byte",
      "types": [
        "lamp",
        "script"
      ],
      "required": true
    },
    {
      "key": "power0",
      "title": "Мощность, Вт",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: ватты не помещаются в датчик"
    },
    {
      "key": "energy0",
      "title": "Энергия, кВт·ч",
      "form": "text",
      "types": [
        "virtual"
      ]
    },
    {
      "key": "input0",
      "title": "Вход SW — положение клеммы",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script"
      ]
    },
    {
      "key": "voltage",
      "title": "Напряжение сети, В",
      "form": "text",
      "types": [
        "virtual"
      ]
    },
    {
      "key": "temp",
      "title": "Температура устройства, °C",
      "form": "sensor",
      "types": [
        "temperature-sensor",
        "float-sensor",
        "virtual"
      ]
    },
    {
      "key": "overtemp",
      "title": "Признак перегрева",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script"
      ]
    },
    {
      "key": "online",
      "title": "Устройство на связи",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: «онлайн» или «офлайн» словом, а не лампой"
    },
    {
      "key": "signal",
      "title": "Уровень сигнала WiFi",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: плохой, нормальный или хороший"
    }
  ],
  "links": [
    {
      "name": "Канал 0 — состояние",
      "direction": "in",
      "role": "ch0",
      "pair": "ch0",
      "topic": "{{prefix}}/relay/0",
      "encode": "byte",
      "values": {
        "on": "1",
        "off": "0",
        "overpower": "0"
      }
    },
    {
      "name": "Канал 0 — команда",
      "direction": "out",
      "role": "ch0",
      "pair": "ch0",
      "topic": "{{prefix}}/relay/0/command",
      "kind": "command",
      "decode": "lamp",
      "qos": 1,
      "values": {
        "on": "on",
        "off": "off",
        "toggle": "toggle"
      }
    },
    {
      "name": "Мощность канала 0",
      "direction": "in",
      "role": "power0",
      "topic": "{{prefix}}/relay/0/power",
      "encode": "text",
      "unit": " Вт",
      "precision": 0
    },
    {
      "name": "Энергия канала 0",
      "direction": "in",
      "role": "energy0",
      "topic": "{{prefix}}/relay/0/energy",
      "encode": "text",
      "unit": " кВт",
      "precision": 1,
      "scale": 1.6666666666666667e-05
    },
    {
      "name": "Вход SW",
      "direction": "in",
      "role": "input0",
      "topic": "{{prefix}}/input/0",
      "encode": "byte"
    },
    {
      "name": "Напряжение сети",
      "direction": "in",
      "role": "voltage",
      "topic": "{{prefix}}/voltage",
      "encode": "text",
      "unit": " В",
      "precision": 0
    },
    {
      "name": "Температура устройства",
      "direction": "in",
      "role": "temp",
      "topic": "{{prefix}}/temperature",
      "encode": "sensor"
    },
    {
      "name": "Перегрев",
      "direction": "in",
      "role": "overtemp",
      "topic": "{{prefix}}/overtemperature",
      "encode": "byte"
    },
    {
      "name": "На связи",
      "direction": "in",
      "role": "online",
      "topic": "{{prefix}}/online",
      "encode": "text",
      "values": {
        "true": "онлайн",
        "false": "офлайн"
      }
    },
    {
      "name": "Уровень сигнала WiFi",
      "direction": "in",
      "role": "signal",
      "topic": "{{prefix}}/info",
      "extract": "json",
      "extract_path": "wifi_sta.rssi",
      "encode": "text",
      "values": {
        "<=-80": "плохой",
        "<=-70": "нормальный",
        "*": "хороший"
      }
    }
  ]
}
