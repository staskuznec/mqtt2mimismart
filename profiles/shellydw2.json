{
  "name": "Shelly Door/Window 2 — геркон",
  "model": "SHDW-2",
  "note": "Батарейный датчик открытия с освещённостью, наклоном и вибрацией. Публикует при пробуждении и при срабатывании. Уровень сигнала WiFi берётся из топика info: полный статус устройство публикует при пробуждении, поэтому уровень обновляется вместе с остальными значениями, а не постоянно.",
  "roles": [
    {
      "key": "state",
      "title": "Открыто / закрыто",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script"
      ],
      "required": true
    },
    {
      "key": "lux",
      "title": "Освещённость",
      "form": "sensor",
      "types": [
        "illumination-sensor",
        "percent-sensor",
        "virtual"
      ]
    },
    {
      "key": "tilt",
      "title": "Наклон, градусы",
      "form": "sensor",
      "types": [
        "temperature-sensor",
        "float-sensor",
        "virtual"
      ]
    },
    {
      "key": "vibration",
      "title": "Вибрация",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script"
      ]
    },
    {
      "key": "battery",
      "title": "Заряд батареи, %",
      "form": "sensor",
      "types": [
        "humidity-sensor",
        "percent-sensor",
        "virtual"
      ]
    },
    {
      "key": "signal",
      "title": "Уровень сигнала WiFi",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: плохой, нормальный или хороший"
    }
  ],
  "links": [
    {
      "name": "Открытие",
      "direction": "in",
      "role": "state",
      "topic": "{{prefix}}/sensor/state",
      "encode": "byte",
      "values": {
        "open": "1",
        "close": "0"
      },
      "only_changed": false
    },
    {
      "name": "Освещённость",
      "direction": "in",
      "role": "lux",
      "topic": "{{prefix}}/sensor/lux",
      "encode": "sensor",
      "only_changed": false
    },
    {
      "name": "Наклон",
      "direction": "in",
      "role": "tilt",
      "topic": "{{prefix}}/sensor/tilt",
      "encode": "sensor",
      "only_changed": false
    },
    {
      "name": "Вибрация",
      "direction": "in",
      "role": "vibration",
      "topic": "{{prefix}}/sensor/vibration",
      "encode": "byte",
      "values": {
        "true": "1",
        "false": "0"
      },
      "only_changed": false
    },
    {
      "name": "Заряд батареи",
      "direction": "in",
      "role": "battery",
      "topic": "{{prefix}}/sensor/battery",
      "encode": "sensor",
      "only_changed": false
    },
    {
      "name": "Уровень сигнала WiFi",
      "direction": "in",
      "role": "signal",
      "topic": "{{prefix}}/info",
      "extract": "json",
      "extract_path": "wifi_sta.rssi",
      "encode": "text",
      "values": {
        "<=-80": "плохой",
        "<=-70": "нормальный",
        "*": "хороший"
      },
      "only_changed": false
    }
  ]
}
