{
  "name": "Shelly Plus 1 — реле без измерения",
  "model": "SNSW-001X16EU",
  "note": "Сухой контакт на один канал, без измерения мощности. Профиль подходит и для Shelly Pro 1 — топики у них одинаковые. В настройках устройства → MQTT включите «Generic status update over MQTT» (status_ntf), иначе оно не публикует состояние вовсе и связки останутся пустыми. Префикс топика по умолчанию — идентификатор устройства, например shellyplus1pm-a8032abd1eb4. Уровень сигнала WiFi берётся из status/wifi. Gen2 публикует этот топик при изменении состояния подключения, а не по таймеру, поэтому обновляется он реже, чем на Gen1.",
  "roles": [
    {
      "key": "ch0",
      "title": "Канал",
      "form": "byte",
      "types": [
        "lamp",
        "script"
      ],
      "required": true
    },
    {
      "key": "temp",
      "title": "Температура устройства, °C",
      "form": "sensor",
      "types": [
        "temperature-sensor",
        "float-sensor",
        "virtual"
      ]
    },
    {
      "key": "in0",
      "title": "Вход 0",
      "form": "byte",
      "types": [
        "switch",
        "door-sensor",
        "script",
        "lamp"
      ]
    },
    {
      "key": "online",
      "title": "Устройство на связи",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: «онлайн» или «офлайн» словом, а не лампой"
    },
    {
      "key": "signal",
      "title": "Уровень сигнала WiFi",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: плохой, нормальный или хороший"
    }
  ],
  "links": [
    {
      "name": "Канал — состояние",
      "direction": "in",
      "role": "ch0",
      "pair": "ch0",
      "topic": "{{prefix}}/status/switch:0",
      "extract": "json",
      "extract_path": "output",
      "encode": "byte",
      "values": {
        "true": "1",
        "false": "0"
      }
    },
    {
      "name": "Канал — команда",
      "direction": "out",
      "role": "ch0",
      "pair": "ch0",
      "topic": "{{prefix}}/rpc",
      "kind": "command",
      "decode": "lamp",
      "qos": 1,
      "values": {
        "on": "{\"id\":1,\"src\":\"mqtt2mimismart\",\"method\":\"Switch.Set\",\"params\":{\"id\":0,\"on\":true}}",
        "off": "{\"id\":1,\"src\":\"mqtt2mimismart\",\"method\":\"Switch.Set\",\"params\":{\"id\":0,\"on\":false}}",
        "toggle": "{\"id\":1,\"src\":\"mqtt2mimismart\",\"method\":\"Switch.Toggle\",\"params\":{\"id\":0}}"
      }
    },
    {
      "name": "Температура устройства",
      "direction": "in",
      "role": "temp",
      "topic": "{{prefix}}/status/switch:0",
      "extract": "json",
      "extract_path": "temperature.tC",
      "encode": "sensor"
    },
    {
      "name": "Вход 0",
      "direction": "in",
      "role": "in0",
      "topic": "{{prefix}}/status/input:0",
      "extract": "json",
      "extract_path": "state",
      "encode": "byte",
      "values": {
        "true": "1",
        "false": "0"
      }
    },
    {
      "name": "На связи",
      "direction": "in",
      "role": "online",
      "topic": "{{prefix}}/online",
      "encode": "text",
      "values": {
        "true": "онлайн",
        "false": "офлайн"
      }
    },
    {
      "name": "Уровень сигнала WiFi",
      "direction": "in",
      "role": "signal",
      "topic": "{{prefix}}/status/wifi",
      "extract": "json",
      "extract_path": "rssi",
      "encode": "text",
      "values": {
        "<=-80": "плохой",
        "<=-70": "нормальный",
        "*": "хороший"
      }
    }
  ]
}
