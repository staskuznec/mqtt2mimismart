{
  "name": "Shelly 1 — реле без измерения",
  "model": "SHSW-1",
  "note": "Один канал, измерения нет вовсе. Вход SW публикуется только для чтения: физические выключатели обычно заведены в умный дом напрямую. Уровень сигнала WiFi берётся из топика info: туда устройство публикует полный статус с периодом, заданным в настройках MQTT. Если период равен нулю, топик не появится и элемент останется пустым.",
  "roles": [
    {
      "key": "ch0",
      "title": "Канал — свет или нагрузка",
      "form": "byte",
      "types": [
        "lamp",
        "script"
      ],
      "required": true,
      "hint": "состояние приходит с устройства, нажатие уходит командой"
    },
    {
      "key": "input0",
      "title": "Вход SW — положение клеммы",
      "form": "byte",
      "types": [
        "lamp",
        "door-sensor",
        "script"
      ]
    },
    {
      "key": "online",
      "title": "Устройство на связи",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: «онлайн» или «офлайн» словом, а не лампой"
    },
    {
      "key": "signal",
      "title": "Уровень сигнала WiFi",
      "form": "text",
      "types": [
        "virtual"
      ],
      "hint": "текстовый элемент: плохой, нормальный или хороший"
    }
  ],
  "links": [
    {
      "name": "Канал 0 — состояние",
      "direction": "in",
      "role": "ch0",
      "pair": "ch0",
      "topic": "{{prefix}}/relay/0",
      "encode": "byte",
      "values": {
        "on": "1",
        "off": "0",
        "overpower": "1"
      }
    },
    {
      "name": "Канал 0 — команда",
      "direction": "out",
      "role": "ch0",
      "pair": "ch0",
      "topic": "{{prefix}}/relay/0/command",
      "kind": "command",
      "decode": "lamp",
      "qos": 1,
      "values": {
        "on": "on",
        "off": "off",
        "toggle": "toggle"
      }
    },
    {
      "name": "Вход SW",
      "direction": "in",
      "role": "input0",
      "topic": "{{prefix}}/input/0",
      "encode": "byte"
    },
    {
      "name": "На связи",
      "direction": "in",
      "role": "online",
      "topic": "{{prefix}}/online",
      "encode": "text",
      "values": {
        "true": "онлайн",
        "false": "офлайн"
      }
    },
    {
      "name": "Уровень сигнала WiFi",
      "direction": "in",
      "role": "signal",
      "topic": "{{prefix}}/info",
      "extract": "json",
      "extract_path": "wifi_sta.rssi",
      "encode": "text",
      "values": {
        "<=-80": "плохой",
        "<=-70": "нормальный",
        "*": "хороший"
      }
    }
  ]
}
