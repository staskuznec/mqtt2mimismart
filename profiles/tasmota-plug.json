  "links": [
    {
      "name": "Канал — состояние",
      "direction": "in",
      "role": "ch0",
      "pair": "ch0",
      "topic": "stat/{{prefix}}/POWER",
      "encode": "byte",
      "values": {
        "ON": "1",
        "OFF": "0"
      }
    },
    {
      "name": "Канал — команда",
      "direction": "out",
      "role": "ch0",
      "pair": "ch0",
      "topic": "cmnd/{{prefix}}/POWER",
      "kind": "command",
      "decode": "lamp",
      "qos": 1,
      "values": {
        "on": "ON",
        "off": "OFF",
        "toggle": "TOGGLE"
      }
    },
    {
